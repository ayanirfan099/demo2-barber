# ── Supabase (Settings → API) ─────────────────────────────────────────────
# Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — safe for the browser
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# ── Stripe (Settings → Developers → API keys) ─────────────────────────────
# Secret key (sk_test_...) — SERVER ONLY, never in frontend code
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Webhook signing secret (whsec_...) — from Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Supabase server key (API Keys → Secret keys) — SERVER ONLY ────────────
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ── Resend (E-Mails — https://resend.com → API Keys) ──────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
