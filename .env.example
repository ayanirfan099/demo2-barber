# ── Supabase (Settings → API) ─────────────────────────────────────────────
# Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — safe for the browser
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Optional server-side fallback for the functions in api/ (same value as above)
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ── Stripe (Settings → Developers → API keys) ─────────────────────────────
# Secret key (sk_test_...) — SERVER ONLY, never in frontend code
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Webhook signing secret (whsec_...) — from Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Supabase server key (API Keys → Secret keys) — SERVER ONLY ────────────
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ── Resend (E-Mails — https://resend.com → API Keys) ──────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Vapi AI receptionist (https://dashboard.vapi.ai) ──────────────────────
# Public key — exposed to the browser by design
VITE_VAPI_PUBLIC_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Assistant ID shown on the voice booking page
VITE_VAPI_ASSISTANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Shared secret for /api/ai-tools — SERVER ONLY. Set the same value as the
# x-ai-secret header on the Vapi tool server. Leave empty to disable the check.
VAPI_TOOL_SECRET=

# ── Site ──────────────────────────────────────────────────────────────────
# Public base URL used in emails and payment links (defaults to the Vercel URL)
SITE_URL=https://demo2-barber-jade.vercel.app
