+/* ════════ DESIGN-UPGRADE HELPERS: payment badges, avatars, barber colors ════════ */
+
+type PaymentKind = 'paid' | 'salon' | 'unpaid' | 'none';
+
+const paymentKind = (a: Appointment): PaymentKind => {
+  if (a.status === 'canceled') return 'none';
+  if (a.status === 'completed') return 'paid'; // collected
+  if (!a.paymentMethod) return 'none';
+  if (a.paymentMethod === 'online') return a.status === 'pending' ? 'unpaid' : 'paid';
+  return 'salon';
+};
+
+const BARBER_DOT: Record<string, string> = {
+  jonas: 'bg-orange-400', marco: 'bg-sky-400', david: 'bg-emerald-400', lena: 'bg-violet-400', any: 'bg-taupe',
+};
+
+const AVATAR_TONES = ['bg-orange-400/85', 'bg-sky-400/85', 'bg-emerald-400/85', 'bg-violet-400/85', 'bg-rose-400/85', 'bg-amber-400/85'];
+
+const initials = (name: string) =>
+  name.trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase() || '?';
+
+const avatarTone = (name: string) =>
+  AVATAR_TONES[[...name].reduce((h, c) => h + c.charCodeAt(0), 0) % AVATAR_TONES.length];
+
+function Avatar({ name, size = 34 }: { name: string; size?: number }) {
+  return (
+    <span
+      className={`flex shrink-0 items-center justify-center rounded-full font-display font-black text-ink ${avatarTone(name)}`}
+      style={{ width: size, height: size, fontSize: Math.round(size * 0.36) }}
+      aria-hidden
+    >
+      {initials(name)}
+    </span>
+  );
+}
+
+function PaymentPill({ kind, lang }: { kind: PaymentKind; lang: 'de' | 'en' }) {
+  if (kind === 'none') return <span className="text-taupe">—</span>;
+  const cfg = {
+    paid: { cls: 'border-emerald-400/30 bg-emerald-400/10 text-emerald-300', de: 'Bezahlt', en: 'Paid', Icon: CreditCard },
+    salon: { cls: 'border-amber-400/30 bg-amber-400/10 text-amber-200', de: 'Im Salon', en: 'At salon', Icon: Wallet },
+    unpaid: { cls: 'border-red-400/30 bg-red-400/10 text-red-300', de: 'Unbezahlt', en: 'Unpaid', Icon: AlertCircle },
+  }[kind];
+  const { Icon } = cfg;
+  return (
+    <span className={`inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[9px] font-bold uppercase tracking-[0.12em] ${cfg.cls}`}>
+      <Icon size={10} aria-hidden /> {lang === 'de' ? cfg.de : cfg.en}
+    </span>
+  );
+}
+
+async function resendConfirmation(
+  a: Appointment,
+  toast: (msg: string, kind?: 'success' | 'error' | 'info') => void,
+  lang: 'de' | 'en'
+) {
+  try {
+    let token = '';
+    if (supabase) {
+      const { data } = await supabase.auth.getSession();
+      token = data.session?.access_token ?? '';
+    }
+    const r = await fetch('/api/resend-email', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
+      body: JSON.stringify({ bookingId: a.id }),
+    });
+    const out = await r.json().catch(() => ({}));
+    if (r.ok && out?.ok) toast(lang === 'de' ? 'Bestätigungs-E-Mail gesendet ✓' : 'Confirmation email sent ✓', 'success');
+    else toast(lang === 'de' ? 'E-Mail fehlgeschlagen' : 'Email failed', 'error');
+  } catch {
+    toast(lang === 'de' ? 'E-Mail fehlgeschlagen' : 'Email failed', 'error');
+  }
+}
